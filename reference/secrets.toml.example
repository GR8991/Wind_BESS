# COPY THIS TEMPLATE to .streamlit/secrets.toml for local development.
# Never commit the real secrets.toml file to GitHub.
# Replace all placeholders with values from your identity-provider app registration.

[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = "REPLACE_WITH_A_LONG_RANDOM_SECRET"

[auth.microsoft]
client_id = "REPLACE_WITH_MICROSOFT_ENTRA_APPLICATION_CLIENT_ID"
client_secret = "REPLACE_WITH_MICROSOFT_ENTRA_CLIENT_SECRET"
server_metadata_url = "https://login.microsoftonline.com/REPLACE_WITH_TENANT_ID/v2.0/.well-known/openid-configuration"

[access]
allowed_emails = [
  "approved.user@yourcompany.com",
  "another.approved.user@yourcompany.com"
]
